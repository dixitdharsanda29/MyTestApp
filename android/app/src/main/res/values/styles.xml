<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:datePickerDialogTheme">@style/DatePickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/TimePickerTheme</item>
    </style>

    <!-- Date Picker Dialog Theme -->
    <style name="DatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorAccent">#007AFF</item>
        <item name="colorControlActivated">#007AFF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Time Picker Dialog Theme -->
    <style name="TimePickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorAccent">#007AFF</item>
        <item name="colorControlActivated">#007AFF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

</resources>
